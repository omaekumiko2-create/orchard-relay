{
  "name": "orchard-relay",
  "productName": "Orchard Relay",
  "version": "0.1.0",
  "description": "A Windows desktop app that builds and installs iOS apps through your Mac.",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "omaekumiko2-create",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omaekumiko2-create/orchard-relay.git"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir --win --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "io.github.omaekumiko2create.orchardrelay",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "mac/runner.py",
      "public/**",
      "server.mjs",
      "config.example.json",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "OrchardRelay-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Orchard Relay",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.15.3"
  }
}
